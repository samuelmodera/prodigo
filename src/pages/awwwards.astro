---
/**
 * AWWWARDS CONCEPT — "Pre-flight"
 * Landing cinematográfica para Pródigo Labs. Página autocontenida:
 * no usa BaseLayout ni global.css. GSAP (ScrollTrigger) + Three.js
 * (shader halftone interactivo, eco del grabado renacentista).
 * Dark-first, tipográfica, sin imágenes.
 */
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource-variable/dm-sans';
import '@fontsource/dm-mono/400.css';
import '@fontsource/dm-mono/500.css';
import { Image } from 'astro:assets';
import turikunzaImg from '../assets/portfolio/turi-edit.PNG';
import focaloImg from '../assets/portfolio/focalo1.png';
import ritualiaImg from '../assets/portfolio/ritualia1.png';

const title = 'Pródigo Labs — Product Systems Lab';
const description =
  'Convertimos procesos desordenados, planillas y operación manual en sistemas digitales claros, simples y escalables.';
const currentYear = new Date().getFullYear();

const checklist = ['Sistemas', 'Diseño', 'Código', 'Lanzamiento'];

const metodo = [
  {
    n: '01',
    t: 'Diagnóstico',
    d: 'Entendemos la operación real: quién hace qué, dónde se pierde tiempo y qué proceso vale la pena sistematizar primero.'
  },
  {
    n: '02',
    t: 'Diseño del sistema',
    d: 'Definimos el flujo correcto antes de dibujar pantallas. El modelo de negocio manda; la interfaz obedece.'
  },
  {
    n: '03',
    t: 'Construcción',
    d: 'Desarrollamos por etapas verificables, como un checklist de cabina: nada avanza sin estar probado.'
  },
  {
    n: '04',
    t: 'Lanzamiento e iteración',
    d: 'Salimos a producción con lo esencial y evolucionamos el sistema junto a la operación, mes a mes.'
  }
];

const proyectos = [
  {
    idx: '01',
    nombre: 'Turikunza',
    tipo: 'De planillas → SaaS',
    anio: '2023',
    metric: '68',
    unit: '%',
    metricLabel: 'menos carga administrativa',
    extra: '0 sobreventas desde el lanzamiento',
    img: turikunzaImg,
    alt: 'Panel de reservas de Turikunza en un MacBook: métricas de tours, calendario y reservas recientes',
    url: 'https://turikunza.cl'
  },
  {
    idx: '02',
    nombre: 'Flota Municipal',
    tipo: 'De operación manual → Control',
    anio: '2024',
    metric: '99.8',
    unit: '%',
    metricLabel: 'de uptime en producción',
    extra: 'Trazabilidad completa de la flota',
    img: null,
    alt: '',
    url: ''
  },
  {
    idx: '03',
    nombre: 'Focalo',
    tipo: 'De caos → Sistema',
    anio: '2025',
    metric: '1',
    unit: '',
    metricLabel: 'sola herramienta central',
    extra: 'Objetivos, key results y tareas con IA',
    img: focaloImg,
    alt: 'Landing de Focalo: "Turn goals into focused execution" con el dashboard de objetivos',
    url: 'https://focalo.co'
  },
  {
    idx: '04',
    nombre: 'Ritualia',
    tipo: 'De idea → MVP',
    anio: '2026',
    metric: '100',
    unit: '%',
    metricLabel: 'del problema validado primero',
    extra: 'Antes de la primera línea de código',
    img: ritualiaImg,
    alt: 'Portada de Ritualia: "Rituales que ocurren cuando alguien abre la puerta de su casa"',
    url: 'https://ritualexperience.lovable.app'
  }
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Concepto interno: no indexar mientras sea borrador -->
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0d0f0b" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <!-- ============ PRELOADER : pre-flight check ============ -->
    <div class="preloader" aria-hidden="true">
      <div class="pl-inner">
        <ul class="pl-list">
          {checklist.map((c) => (
            <li class="pl-item">
              <span class="pl-name">{c}</span>
              <span class="pl-check">OK ✓</span>
            </li>
          ))}
        </ul>
        <div class="pl-bottom">
          <span class="pl-label">Pre-flight check</span>
          <span class="pl-count">000</span>
        </div>
        <div class="pl-bar"><span class="pl-bar-fill"></span></div>
      </div>
    </div>

    <!-- ============ CURSOR (solo pointer fino) ============ -->
    <div class="cursor" aria-hidden="true">
      <div class="cursor-dot"></div>
      <div class="cursor-ring"></div>
    </div>

    <!-- ============ NAV ============ -->
    <header class="topbar">
      <a href="/awwwards" class="brand" data-magnetic aria-label="Pródigo Labs, inicio">
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 9 9" focusable="false">
            <rect x="0" y="0" width="9" height="2.5"></rect>
            <rect x="0" y="3.5" width="5.5" height="2.5"></rect>
            <rect x="0" y="7" width="9" height="2"></rect>
          </svg>
        </span>
        <span class="brand-name">Pródigo Labs</span>
      </a>
      <nav aria-label="Navegación principal">
        <a href="#metodo" data-magnetic>Método</a>
        <a href="#proyectos" data-magnetic>Proyectos</a>
        <a href="#nosotros" data-magnetic>Estudio</a>
        <a href="#contacto" class="nav-cta" data-magnetic>Conversemos</a>
      </nav>
    </header>

    <main>
      <!-- ============ HERO ============ -->
      <section class="hero" aria-labelledby="hero-title">
        <canvas class="gl" aria-hidden="true"></canvas>
        <div class="hero-in">
          <p class="kicker reveal-el">
            <span class="kicker-dot" aria-hidden="true"></span>
            Product Systems Lab · Santiago, Chile
          </p>
          <h1 id="hero-title">
            <span class="hl"><span class="hl-in">Sistemas que</span></span>
            <span class="hl"><span class="hl-in"><em>ordenan</em> operaciones</span></span>
            <span class="hl"><span class="hl-in">reales.</span></span>
          </h1>
          <div class="hero-foot">
            <p class="lede reveal-el">
              Convertimos planillas, correos y operación manual en sistemas
              digitales claros, simples y escalables — con la disciplina de un
              <strong>Comandante de A320</strong>.
            </p>
            <div class="hero-actions reveal-el">
              <a class="btn btn-solid" href="#contacto" data-magnetic>Conversemos <span aria-hidden="true">→</span></a>
              <a class="btn btn-line" href="#proyectos" data-magnetic>Ver proyectos</a>
            </div>
          </div>
        </div>
        <div class="scroll-hint reveal-el" aria-hidden="true">
          <span>Scroll</span>
          <span class="scroll-line"></span>
        </div>
      </section>

      <!-- ============ MARQUEE ============ -->
      <div class="marquee" aria-hidden="true">
        <div class="marquee-track">
          <span class="mq-group">
            De planillas <i>→</i> SaaS&ensp;·&ensp;De caos <i>→</i> Sistema&ensp;·&ensp;De idea <i>→</i> MVP&ensp;·&ensp;
          </span>
          <span class="mq-group">
            De planillas <i>→</i> SaaS&ensp;·&ensp;De caos <i>→</i> Sistema&ensp;·&ensp;De idea <i>→</i> MVP&ensp;·&ensp;
          </span>
        </div>
      </div>

      <!-- ============ MANIFIESTO / PROBLEMA ============ -->
      <section class="manifesto" aria-labelledby="manifesto-title">
        <p class="label">El problema</p>
        <h2 id="manifesto-title" class="mani-text">
          La mayoría de los negocios digitalizan herramientas, no sus
          operaciones. El resultado: más aplicaciones, más fricción,
          <em>menos claridad.</em>
        </h2>
        <ul class="pains">
          <li class="pain reveal-up"><span class="pain-n">01</span>Operaciones fragmentadas en correos, WhatsApp y planillas.</li>
          <li class="pain reveal-up"><span class="pain-n">02</span>Sistemas frágiles que crecieron sin estructura.</li>
          <li class="pain reveal-up"><span class="pain-n">03</span>Procesos que dependen de una sola persona.</li>
          <li class="pain reveal-up"><span class="pain-n">04</span>Productos construidos sin validar el problema real.</li>
        </ul>
      </section>

      <!-- ============ MÉTODO (pinned) ============ -->
      <section class="metodo" id="metodo" aria-labelledby="metodo-title">
        <div class="metodo-pin">
          <div class="metodo-grid">
            <div class="metodo-left">
              <p class="label">El método</p>
              <h2 id="metodo-title">Checklist,<br /><em>no improvisación.</em></h2>
              <p class="metodo-sub">
                En aviación nada crítico se deja a la memoria. Operamos los
                proyectos igual: cuatro etapas verificables.
              </p>
              <p class="metodo-progress" aria-hidden="true">
                <span class="mp-current">01</span> / 04
              </p>
            </div>
            <ol class="steps">
              {metodo.map((m, i) => (
                <li class={`step ${i === 0 ? 'is-active' : ''}`}>
                  <span class="step-n" aria-hidden="true">{m.n}</span>
                  <div>
                    <h3>{m.t}</h3>
                    <p>{m.d}</p>
                  </div>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </section>

      <!-- ============ PROYECTOS (horizontal) ============ -->
      <section class="work" id="proyectos" aria-labelledby="proyectos-title">
        <div class="work-head">
          <p class="label">Proyectos</p>
          <h2 id="proyectos-title">Trabajo real. <em>Resultados concretos.</em></h2>
        </div>
        <div class="hs">
          <div class="hs-track">
            {proyectos.map((p) => (
              <article class={`case ${p.img ? 'case--media' : 'case--type'}`}>
                <span class="case-chip" aria-hidden="true">{p.idx}</span>
                <span class="case-year">{p.anio}</span>
                {p.img && (
                  <div class="case-media">
                    <Image
                      src={p.img}
                      alt={p.alt}
                      widths={[480, 800, 1200]}
                      sizes="(max-width: 640px) 82vw, 600px"
                      formats={['avif', 'webp']}
                      quality={72}
                      loading="lazy"
                    />
                  </div>
                )}
                <div class="case-body">
                  <p class="case-type">{p.tipo}</p>
                  <h3>
                    {p.url ? (
                      <a class="case-link" href={p.url} target="_blank" rel="noopener">
                        {p.nombre} <span class="case-ext" aria-hidden="true">↗</span>
                      </a>
                    ) : (
                      p.nombre
                    )}
                  </h3>
                  <p class="case-metric">
                    <span class="count" data-count={p.metric}>0</span><span class="case-unit">{p.unit}</span>
                    <span class="case-metric-label">{p.metricLabel}</span>
                  </p>
                  <p class="case-extra">{p.extra}</p>
                </div>
              </article>
            ))}
            <article class="case case-reel" aria-label="Ejemplo de contenido en video">
              <video
                class="reel"
                src="/media/reel-demo.mp4"
                muted
                loop
                playsinline
                preload="metadata"
              ></video>
              <div class="reel-tag">
                <p class="case-type">Motion · Contenido</p>
                <h3>El sistema también<br />se muestra.</h3>
              </div>
            </article>
            <article class="case case--type case-cta">
              <div class="case-body">
                <h3><em>¿Tu operación</em><br />es la próxima?</h3>
                <a class="btn btn-solid" href="#contacto" data-magnetic>Conversemos <span aria-hidden="true">→</span></a>
              </div>
            </article>
          </div>
        </div>
      </section>

      <!-- ============ ESTUDIO ============ -->
      <section class="studio" id="nosotros" aria-labelledby="nosotros-title">
        <p class="label">El estudio</p>
        <h2 id="nosotros-title" class="sr-only">Quiénes somos</h2>
        <blockquote class="studio-quote reveal-up">
          "No partimos preguntando ¿cómo se ve la pantalla? sino ¿qué problema
          estamos resolviendo, para quién y dentro de qué modelo de negocio?"
        </blockquote>
        <div class="founder reveal-up">
          <span class="avatar" aria-hidden="true">S</span>
          <div>
            <p class="f-name">Samuel Moder</p>
            <p class="f-role">Comandante A320 · Product Builder · Fundador</p>
          </div>
        </div>
        <dl class="stats">
          <div class="stat reveal-up">
            <dt>Sistemas en producción</dt>
            <dd><span class="count" data-count="4">0</span></dd>
          </div>
          <div class="stat reveal-up">
            <dt>End-to-end, diagnóstico a lanzamiento</dt>
            <dd><span class="count" data-count="100">0</span>%</dd>
          </div>
          <div class="stat reveal-up">
            <dt>Años operando sistemas de alto riesgo</dt>
            <dd><span class="count" data-count="10">0</span>+</dd>
          </div>
          <div class="stat reveal-up">
            <dt>Clientes activos máximo</dt>
            <dd>2–3</dd>
          </div>
        </dl>
      </section>

      <!-- ============ CTA ============ -->
      <section class="cta" id="contacto" aria-labelledby="contacto-title">
        <p class="label">Contacto</p>
        <h2 id="contacto-title" class="sr-only">Hablemos de tu operación</h2>
        <a class="mega" href="mailto:hola@prodigolabs.com" data-magnetic>
          <span class="mega-line"><span class="mega-in">Hablemos de</span></span>
          <span class="mega-line"><span class="mega-in"><em>tu operación</em> <span class="mega-arrow" aria-hidden="true">→</span></span></span>
        </a>
        <p class="cta-mail">
          hola@prodigolabs.com · respondemos dentro de un día hábil
        </p>
      </section>
    </main>

    <footer>
      <span class="f-brand">Pródigo Labs</span>
      <nav aria-label="Navegación de pie de página">
        <a href="#metodo">Método</a>
        <a href="#proyectos">Proyectos</a>
        <a href="#nosotros">Estudio</a>
      </nav>
      <span class="f-copy">© {currentYear} · Santiago, Chile · 33.45°S 70.66°W</span>
    </footer>

    <style is:global>
      /* ============ Tokens (dark cinematográfico, un solo tema) ===== */
      :root {
        --bg: #0d0f0b;
        --bg2: #12140f;
        --ink: #f2efe6;
        --muted: rgba(242, 239, 230, 0.55);
        --faint: rgba(242, 239, 230, 0.28);
        --line: rgba(242, 239, 230, 0.12);
        --olive: #7aad7d;
        --olive-soft: #9bc79e;

        --serif: 'Instrument Serif', Georgia, serif;
        --sans: 'DM Sans Variable', 'DM Sans', system-ui, sans-serif;
        --mono: 'DM Mono', ui-monospace, Menlo, monospace;

        --gutter: clamp(1.25rem, 5vw, 6rem);
        --space: clamp(6rem, 12vw, 11rem);
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        font-family: var(--sans);
        background: var(--bg);
        color: var(--ink);
        line-height: 1.65;
        overflow-x: hidden;
      }

      body.is-loading {
        overflow: hidden;
      }

      ::selection {
        background: var(--olive);
        color: var(--bg);
      }

      section[id] {
        scroll-margin-top: 4rem;
      }

      a:focus-visible,
      button:focus-visible {
        outline: 2px solid var(--olive);
        outline-offset: 4px;
      }

      em {
        font-style: italic;
        color: var(--olive-soft);
      }

      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip: rect(0 0 0 0);
        white-space: nowrap;
      }

      .label {
        font-family: var(--mono);
        font-size: 0.7rem;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--olive);
        margin-bottom: 1.5rem;
      }

      /* ============ Preloader ============ */
      .preloader {
        position: fixed;
        inset: 0;
        z-index: 300;
        background: var(--bg);
        display: flex;
        align-items: flex-end;
      }

      .pl-inner {
        width: 100%;
        padding: var(--gutter);
      }

      .pl-list {
        list-style: none;
        margin-bottom: 3rem;
      }

      .pl-item {
        display: flex;
        justify-content: space-between;
        max-width: 380px;
        font-family: var(--mono);
        font-size: 0.8rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--muted);
        padding: 0.45rem 0;
        border-bottom: 1px solid var(--line);
        opacity: 0;
      }

      .pl-check {
        color: var(--olive);
      }

      .pl-bottom {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-bottom: 0.8rem;
      }

      .pl-label {
        font-family: var(--mono);
        font-size: 0.7rem;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--faint);
      }

      .pl-count {
        font-family: var(--serif);
        font-size: clamp(3.5rem, 9vw, 7rem);
        line-height: 0.9;
        color: var(--ink);
        font-variant-numeric: tabular-nums;
      }

      .pl-bar {
        height: 1px;
        background: var(--line);
      }

      .pl-bar-fill {
        display: block;
        height: 100%;
        width: 100%;
        background: var(--olive);
        transform: scaleX(0);
        transform-origin: left;
      }

      /* ============ Cursor ============ */
      .cursor {
        display: none;
      }

      @media (pointer: fine) {
        .cursor {
          display: block;
          position: fixed;
          top: 0;
          left: 0;
          z-index: 400;
          pointer-events: none;
        }

        .cursor-dot {
          position: absolute;
          width: 6px;
          height: 6px;
          margin: -3px;
          border-radius: 50%;
          background: var(--olive-soft);
        }

        .cursor-ring {
          position: absolute;
          width: 34px;
          height: 34px;
          margin: -17px;
          border-radius: 50%;
          border: 1px solid var(--faint);
          transition: transform 0.25s ease, border-color 0.25s ease;
        }

        .cursor.is-hover .cursor-ring {
          transform: scale(1.8);
          border-color: var(--olive);
        }
      }

      /* ============ Topbar ============ */
      .topbar {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 100;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.2rem var(--gutter);
        transition: transform 0.45s cubic-bezier(0.4, 0, 0.2, 1);
        background: linear-gradient(rgba(13, 15, 11, 0.85), rgba(13, 15, 11, 0));
      }

      .topbar.is-hidden {
        transform: translateY(-110%);
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        font-family: var(--serif);
        font-size: 1.1rem;
        color: var(--ink);
        text-decoration: none;
      }

      .brand-mark {
        display: inline-flex;
        width: 22px;
        height: 22px;
        padding: 4px;
        background: var(--olive);
        border-radius: 5px;
      }

      .brand-mark svg {
        width: 100%;
        fill: var(--bg);
      }

      .topbar nav {
        display: flex;
        gap: clamp(1rem, 2.5vw, 2.25rem);
      }

      .topbar nav a {
        font-family: var(--mono);
        font-size: 0.72rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--muted);
        text-decoration: none;
        transition: color 0.2s;
      }

      .topbar nav a:hover {
        color: var(--ink);
      }

      .topbar nav a.nav-cta {
        color: var(--olive);
      }

      /* ============ Hero ============ */
      .hero {
        position: relative;
        min-height: 100svh;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        padding: calc(var(--gutter) + 4rem) var(--gutter) var(--gutter);
        overflow: hidden;
      }

      .gl {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        display: block;
      }

      .hero-in {
        position: relative;
        z-index: 2;
      }

      .kicker {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        font-family: var(--mono);
        font-size: 0.72rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--muted);
        margin-bottom: 2rem;
      }

      .kicker-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--olive);
        flex: none;
      }

      .hero h1 {
        font-family: var(--serif);
        font-weight: 400;
        font-size: clamp(3rem, 9.5vw, 8.6rem);
        line-height: 0.98;
        letter-spacing: -0.015em;
        margin-bottom: clamp(2rem, 4vw, 3.5rem);
      }

      .hl {
        display: block;
        overflow: hidden;
        padding-block: 0.06em;
      }

      .hl-in {
        display: block;
        will-change: transform;
      }

      .hero-foot {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 2.5rem;
        flex-wrap: wrap;
        /* deja libre la esquina del indicador de scroll */
        padding-right: clamp(0rem, 6vw, 5rem);
      }

      .lede {
        max-width: 44ch;
        font-weight: 300;
        color: var(--muted);
      }

      .lede strong {
        color: var(--ink);
        font-weight: 500;
      }

      .hero-actions {
        display: flex;
        gap: 0.9rem;
        flex-wrap: wrap;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.85rem 1.7rem;
        border-radius: 100px;
        font-size: 0.9rem;
        font-weight: 600;
        text-decoration: none;
        border: 1px solid transparent;
        transition: background 0.25s, color 0.25s, border-color 0.25s;
      }

      .btn-solid {
        background: var(--ink);
        color: var(--bg);
      }

      .btn-solid:hover {
        background: var(--olive-soft);
      }

      .btn-line {
        border-color: var(--line);
        color: var(--ink);
      }

      .btn-line:hover {
        border-color: var(--olive);
        color: var(--olive-soft);
      }

      .scroll-hint {
        position: absolute;
        right: var(--gutter);
        bottom: var(--gutter);
        z-index: 2;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.6rem;
        font-family: var(--mono);
        font-size: 0.62rem;
        letter-spacing: 0.3em;
        text-transform: uppercase;
        color: var(--faint);
        writing-mode: vertical-rl;
      }

      .scroll-line {
        width: 1px;
        height: 48px;
        background: var(--faint);
        overflow: hidden;
        position: relative;
      }

      .scroll-line::after {
        content: '';
        position: absolute;
        inset: 0;
        background: var(--olive);
        animation: scrollPulse 2.2s ease-in-out infinite;
      }

      @keyframes scrollPulse {
        0% { transform: translateY(-100%); }
        55% { transform: translateY(0); }
        100% { transform: translateY(100%); }
      }

      /* ============ Marquee ============ */
      .marquee {
        overflow: hidden;
        border-block: 1px solid var(--line);
        padding: 1.1rem 0;
        background: var(--bg2);
      }

      .marquee-track {
