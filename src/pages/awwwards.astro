      /* ============ CTA ============ */
      .cta {
        padding: var(--space) var(--gutter);
        border-top: 1px solid var(--line);
      }

      .mega {
        display: block;
        text-decoration: none;
        color: var(--ink);
        font-family: var(--serif);
        font-size: clamp(3rem, 11vw, 10rem);
        line-height: 1;
