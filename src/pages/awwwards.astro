      }

      .cta-mail {
        font-family: var(--mono);
        font-size: 0.75rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--muted);
      }

      /* ============ Footer ============ */
      footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.25rem;
        flex-wrap: wrap;
        padding: 1.75rem var(--gutter);
        border-top: 1px solid var(--line);
      }

      .f-brand {
        font-family: var(--serif);
      }

      footer nav {
        display: flex;
        gap: 1.5rem;
      }

      footer nav a {
        font-family: var(--mono);
        font-size: 0.68rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--muted);
        text-decoration: none;
      }

      footer nav a:hover {
        color: var(--ink);
      }

      .f-copy {
        font-family: var(--mono);
        font-size: 0.68rem;
        color: var(--faint);
      }

      /* ============ Estados iniciales de animación ============ */
      body.js .reveal-el,
      body.js .hl-in,
      body.js .mega-in {
        opacity: 0;
      }

      body.js .reveal-up {
        opacity: 0;
        transform: translateY(28px);
      }

      /* ============ Responsive ============ */
      @media (max-width: 900px) {
        .metodo-grid {
          grid-template-columns: 1fr;
        }

        .metodo-progress {
          display: none;
        }

        .step {
          opacity: 1;
        }

        .stats {
          grid-template-columns: 1fr 1fr;
        }
      }

      @media (max-width: 640px) {
        .topbar nav a:not(.nav-cta) {
          display: none;
        }

        .hero {
          justify-content: center;
        }

        .hero-foot {
          flex-direction: column;
          align-items: flex-start;
        }

        .scroll-hint {
          display: none;
        }

        .hs {
          overflow-x: auto;
          scroll-snap-type: x mandatory;
          -webkit-overflow-scrolling: touch;
        }

        .hs-track {
          width: max-content;
        }

        .case {
          width: 82vw;
          scroll-snap-align: start;
        }

        .case--type {
          min-height: 420px;
        }

        .case-reel {
          width: 68vw;
        }

        .stats {
          grid-template-columns: 1fr;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }

        .marquee-track,
        .scroll-line::after {
          animation: none;
        }

        body.js .reveal-el,
        body.js .hl-in,
        body.js .mega-in,
        body.js .reveal-up {
          opacity: 1;
          transform: none;
        }
      }
    </style>

    <script>
      import gsap from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';
      import * as THREE from 'three';

      gsap.registerPlugin(ScrollTrigger);

      if (import.meta.env.DEV) {
        // Acceso desde la consola para depurar animaciones en desarrollo.
        (window as any).gsap = gsap;
        (window as any).ScrollTrigger = ScrollTrigger;
      }

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const finePointer = window.matchMedia('(pointer: fine)').matches;
      document.body.classList.add('js');

      /* ================= THREE — halftone interactivo ================= */
      const initGL = () => {
        const canvas = document.querySelector<HTMLCanvasElement>('.gl');
        if (!canvas) return;

        const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: false });
        renderer.setClearColor(0x000000, 0);

        const scene = new THREE.Scene();
        const camera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0, 1);

        const uniforms = {
          uTime: { value: 0 },
          uRes: { value: new THREE.Vector2(1, 1) },
          uMouse: { value: new THREE.Vector2(0.7, 0.5) },
          uGrid: { value: 60 },
          uIntro: { value: 0 },
          uDim: { value: 1 }
        };

        const material = new THREE.ShaderMaterial({
          transparent: true,
          uniforms,
          vertexShader: /* glsl */ `
            varying vec2 vUv;
            void main() {
              vUv = uv;
              gl_Position = vec4(position, 1.0);
            }
          `,
          fragmentShader: /* glsl */ `
            precision highp float;
            varying vec2 vUv;
            uniform float uTime;
            uniform vec2 uRes;
            uniform vec2 uMouse;
            uniform float uGrid;
            uniform float uIntro;
            uniform float uDim;

            float hash(vec2 p) {
              return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
            }

            float noise(vec2 p) {
              vec2 i = floor(p);
              vec2 f = fract(p);
              vec2 u = f * f * (3.0 - 2.0 * f);
              return mix(
                mix(hash(i), hash(i + vec2(1.0, 0.0)), u.x),
                mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), u.x),
                u.y
              );
            }

            float fbm(vec2 p) {
              float v = 0.0;
              float a = 0.55;
              for (int i = 0; i < 4; i++) {
                v += a * noise(p);
                p *= 2.1;
                a *= 0.5;
              }
              return v;
            }

            void main() {
              float aspect = uRes.x / uRes.y;
              vec2 p = vec2(vUv.x * aspect, vUv.y);
              vec2 m = vec2(uMouse.x * aspect, uMouse.y);

              vec2 gp = p * uGrid;
              vec2 gv = fract(gp) - 0.5;
              vec2 id = floor(gp);

              float n = fbm(id * 0.08 + uTime * 0.045);

              float md = distance(p, m);
              float ripple = sin(md * 16.0 - uTime * 2.2) * exp(-md * 2.6) * 0.5;
              float glow = exp(-md * 3.2) * 0.55;

              float r = 0.05 + n * 0.34 + (ripple + glow) * 0.4;
              r *= uIntro;
              r = clamp(r, 0.0, 0.47);

              float d = length(gv);
              float dotMask = smoothstep(r, r - 0.09, d);

              /* Zona: denso arriba-derecha, despejado abajo-izquierda (texto) */
              float zone = smoothstep(0.1, 0.9, vUv.x * 0.62 + vUv.y * 0.55 + n * 0.22);

              vec3 olive = vec3(0.478, 0.678, 0.490);
              vec3 cream = vec3(0.949, 0.937, 0.902);
              vec3 col = mix(olive, cream, smoothstep(0.35, 0.95, n) * 0.5 + glow * 0.5);

              float alpha = dotMask * zone * (0.32 + glow * 0.65) * uDim;
              gl_FragColor = vec4(col, alpha);
            }
          `
        });

        scene.add(new THREE.Mesh(new THREE.PlaneGeometry(2, 2), material));

        const isMobile = window.innerWidth < 768;

        const resize = () => {
          const rect = canvas.getBoundingClientRect();
          const dpr = Math.min(window.devicePixelRatio || 1, isMobile ? 1.25 : 1.75);
          renderer.setPixelRatio(dpr);
          renderer.setSize(rect.width, rect.height, false);
          uniforms.uRes.value.set(rect.width, rect.height);
          uniforms.uGrid.value = Math.max(26, rect.height / (isMobile ? 15 : 13));
          uniforms.uDim.value = isMobile ? 0.55 : 1;
        };
        resize();
        window.addEventListener('resize', resize);

        const target = new THREE.Vector2(0.7, 0.55);
        window.addEventListener(
          'pointermove',
          (e) => {
            const rect = canvas.getBoundingClientRect();
            target.set(
              (e.clientX - rect.left) / rect.width,
              1 - (e.clientY - rect.top) / rect.height
            );
          },
          { passive: true }
        );

        gsap.to(uniforms.uIntro, { value: 1, duration: 2.4, ease: 'power2.out', delay: reduceMotion ? 0 : 2 });

        const t0 = performance.now();
        let raf = 0;
        let visible = true;

        const frame = () => {
          uniforms.uTime.value = (performance.now() - t0) / 1000;
          uniforms.uMouse.value.lerp(target, 0.055);
          renderer.render(scene, camera);
          if (visible && !reduceMotion) raf = requestAnimationFrame(frame);
        };

        const io = new IntersectionObserver(([entry]) => {
          visible = entry.isIntersecting;
          if (visible && !raf) {
            raf = requestAnimationFrame(frame);
          } else if (!visible && raf) {
            cancelAnimationFrame(raf);
            raf = 0;
          }
        });
        io.observe(canvas);

        if (reduceMotion) {
          uniforms.uIntro.value = 1;
          renderer.render(scene, camera);
        }
      };
      initGL();

      /* ================= Preloader + intro ================= */
      const heroIntro = () => {
        const tl = gsap.timeline();
        tl.to('.hl-in', { opacity: 1, duration: 0.01, stagger: 0.14 })
          .from('.hl-in', { yPercent: 108, duration: 1.15, ease: 'power4.out', stagger: 0.14 }, '<')
          .to('.reveal-el', { opacity: 1, y: 0, duration: 0.9, ease: 'power3.out', stagger: 0.09 }, '-=0.7');
        return tl;
      };

      const preloader = document.querySelector<HTMLElement>('.preloader');
      if (reduceMotion || !preloader) {
        preloader?.remove();
        gsap.set(['.hl-in', '.reveal-el', '.mega-in'], { opacity: 1 });
      } else {
        document.body.classList.add('is-loading');
        const count = { v: 0 };
        const countEl = document.querySelector('.pl-count');
        const tl = gsap.timeline({
          onComplete: () => {
            preloader.remove();
            document.body.classList.remove('is-loading');
            ScrollTrigger.refresh();
          }
        });
        tl.to('.pl-item', { opacity: 1, duration: 0.3, stagger: 0.18, ease: 'none' })
          .to('.pl-bar-fill', { scaleX: 1, duration: 1.4, ease: 'power2.inOut' }, 0)
          .to(count, {
            v: 100,
            duration: 1.4,
            ease: 'power2.inOut',
            onUpdate: () => {
              if (countEl) countEl.textContent = String(Math.round(count.v)).padStart(3, '0');
            }
          }, 0)
          .to(preloader, { yPercent: -100, duration: 0.85, ease: 'power4.inOut', delay: 0.25 })
          .add(heroIntro(), '-=0.35');
      }

      /* ================= Cursor + magnetic (pointer fino) ============ */
      if (finePointer && !reduceMotion) {
        const cursor = document.querySelector<HTMLElement>('.cursor');
        if (cursor) {
          const xTo = gsap.quickTo(cursor, 'x', { duration: 0.35, ease: 'power3' });
          const yTo = gsap.quickTo(cursor, 'y', { duration: 0.35, ease: 'power3' });
          window.addEventListener(
            'pointermove',
            (e) => {
              xTo(e.clientX);
              yTo(e.clientY);
            },
            { passive: true }
          );
          document.querySelectorAll('a, button').forEach((el) => {
            el.addEventListener('pointerenter', () => cursor.classList.add('is-hover'));
            el.addEventListener('pointerleave', () => cursor.classList.remove('is-hover'));
          });
        }

        document.querySelectorAll<HTMLElement>('[data-magnetic]').forEach((el) => {
          const xTo = gsap.quickTo(el, 'x', { duration: 0.4, ease: 'power3' });
          const yTo = gsap.quickTo(el, 'y', { duration: 0.4, ease: 'power3' });
          el.addEventListener('pointermove', (e) => {
            const r = el.getBoundingClientRect();
            xTo((e.clientX - (r.left + r.width / 2)) * 0.25);
            yTo((e.clientY - (r.top + r.height / 2)) * 0.25);
          });
          el.addEventListener('pointerleave', () => {
            xTo(0);
            yTo(0);
          });
        });
      }

      /* ================= Nav: ocultar al bajar ================= */
      const topbar = document.querySelector<HTMLElement>('.topbar');
      ScrollTrigger.create({
        start: 'top -120',
        onUpdate: (self) => {
          topbar?.classList.toggle('is-hidden', self.direction === 1);
        }
      });

      /* ================= Scroll choreography ================= */
      if (!reduceMotion) {
        /* Manifiesto: palabras que se encienden con scrub */
        const mani = document.querySelector<HTMLElement>('.mani-text');
        if (mani) {
          const split = (node: Node): void => {
            [...node.childNodes].forEach((child) => {
              if (child.nodeType === Node.TEXT_NODE) {
                const frag = document.createDocumentFragment();
                (child.textContent || '').split(/(\s+)/).forEach((part) => {
                  if (/^\s+$/.test(part) || part === '') {
                    frag.appendChild(document.createTextNode(part));
                  } else {
                    const s = document.createElement('span');
                    s.className = 'w';
                    s.textContent = part;
                    frag.appendChild(s);
                  }
                });
                child.replaceWith(frag);
              } else {
                split(child);
              }
            });
          };
          split(mani);
          gsap.to(mani.querySelectorAll('.w'), {
            opacity: 1,
            stagger: 0.6,
            ease: 'none',
            scrollTrigger: {
              trigger: mani,
              start: 'top 78%',
              end: 'bottom 45%',
              scrub: 0.6
            }
          });
        }

        /* Reveals genéricos */
        gsap.utils.toArray<HTMLElement>('.reveal-up').forEach((el) => {
          gsap.to(el, {
            opacity: 1,
            y: 0,
            duration: 0.9,
            ease: 'power3.out',
            scrollTrigger: { trigger: el, start: 'top 86%' }
          });
        });

        /* Mega CTA */
        gsap.fromTo(
          '.mega-in',
          { yPercent: 110, opacity: 1 },
          {
            yPercent: 0,
            opacity: 1,
            duration: 1.1,
            ease: 'power4.out',
            stagger: 0.12,
            scrollTrigger: { trigger: '.cta', start: 'top 72%' }
          }
        );

        /* Contadores */
        gsap.utils.toArray<HTMLElement>('.count').forEach((el) => {
          const end = parseFloat(el.dataset.count || '0');
          const decimals = (el.dataset.count || '').includes('.') ? 1 : 0;
          const obj = { v: 0 };
          gsap.to(obj, {
            v: end,
            duration: 1.6,
            ease: 'power2.out',
            scrollTrigger: { trigger: el, start: 'top 88%' },
            onUpdate: () => {
              el.textContent = obj.v.toFixed(decimals);
            }
          });
        });

        /* Desktop: método pineado + galería horizontal */
        const mm = gsap.matchMedia();
        mm.add('(min-width: 900px)', () => {
          /* Método: pasos que se activan con scrub */
          const steps = gsap.utils.toArray<HTMLElement>('.step');
          const current = document.querySelector('.mp-current');
          const stepTl = gsap.timeline({
            scrollTrigger: {
              trigger: '.metodo',
              start: 'top top',
              end: '+=' + steps.length * 55 + '%',
              pin: '.metodo-pin',
              scrub: true
            }
          });
          steps.forEach((_, i) => {
            stepTl.call(
              () => {
                steps.forEach((s, j) => s.classList.toggle('is-active', j <= i));
                if (current) current.textContent = String(i + 1).padStart(2, '0');
              },
              [],
              i * 0.55
            );
          });
          stepTl.to({}, { duration: steps.length * 0.55 }, 0);

          /* Proyectos: scroll horizontal */
          const track = document.querySelector<HTMLElement>('.hs-track');
          if (track) {
            const dist = () => track.scrollWidth - window.innerWidth;
            const horiz = gsap.to(track, {
              x: () => -dist(),
              ease: 'none',
              scrollTrigger: {
                trigger: '.hs',
                start: 'top 12%',
                end: () => '+=' + dist(),
                pin: true,
                scrub: 1,
                invalidateOnRefresh: true
              }
            });

            /* Parallax interno de las imágenes mientras viaja la galería */
            gsap.utils.toArray<HTMLElement>('.case-media img').forEach((img) => {
              gsap.fromTo(
                img,
                { xPercent: -5 },
                {
                  xPercent: 5,
                  ease: 'none',
                  scrollTrigger: {
                    trigger: img.closest('.case'),
                    containerAnimation: horiz,
                    start: 'left right',
                    end: 'right left',
                    scrub: true
                  }
                }
              );
            });
          }
        });
      } else {
        /* Reduced motion: estado final directo */
        document.querySelectorAll('.count').forEach((el) => {
          el.textContent = (el as HTMLElement).dataset.count || '0';
        });
        document.querySelectorAll('.step').forEach((s) => s.classList.add('is-active'));
      }

      /* ================= Video reel: play sólo en pantalla ============ */
      document.querySelectorAll<HTMLVideoElement>('video.reel').forEach((video) => {
        if (reduceMotion) return;
        const io = new IntersectionObserver(
          ([entry]) => {
            if (entry.isIntersecting) {
              video.play().catch(() => {});
            } else {
              video.pause();
            }
          },
          { threshold: 0.35 }
        );
        io.observe(video);
      });
    </script>
  </body>
</html>
